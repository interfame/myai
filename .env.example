# Base de datos local (SQLite) — ya configurada por defecto
DATABASE_URL=file:./db/custom.db

# ── Producción con Supabase (opcional) ─────────────────────────
# 1) En prisma/schema.prisma cambia provider = "postgresql"
# 2) Usa la connection string de Supabase (Settings → Database):
# DATABASE_URL="postgresql://postgres.[ref]:[pass]@aws-0-[region].pooler.supabase.com:6543/postgres"
#
# 3) O crea las tablas con SQL directo: supabase/schema.sql
